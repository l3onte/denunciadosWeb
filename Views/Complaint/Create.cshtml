                </td>

                <td class="px-4 py-3">
                    <select name="PresumedAuthors[${presumedAuthorIndex}].Sex"
                            class="${inputClass()}">

                        <option value="">
                            Seleccionar
                        </option>

                        <option value="Masculino">
                            Masculino
                        </option>

                        <option value="Femenino">
