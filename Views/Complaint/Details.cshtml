@model denunciadosWeb.Models.ComplaintDetailsViewModel

@{
    ViewData["Title"] = "Detalle de denuncia";

    var statusClass = "bg-blue-50 text-blue-700 border-blue-200";
}

<div class="min-h-[calc(100vh-4rem)] bg-slate-100 px-4 py-6 sm:px-6 lg:px-8">

    <div class="max-w-7xl mx-auto">
        <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

            <div>

                <div class="flex items-center gap-3">

                    <div class="w-11 h-11 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">

                        <i class="fa-solid fa-file-lines"></i>

                    </div>

                    <div>

                        <h2 class="text-2xl font-semibold text-slate-800">
                            Detalle de denuncia
                        </h2>

                        <p class="mt-1 text-sm text-slate-500">
                            Información completa del expediente registrado.
                        </p>

                    </div>

                </div>

            </div>

            <a asp-controller="Home"
               asp-action="Index"
               class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-lg border border-slate-300 bg-white text-slate-600 text-sm font-medium hover:bg-slate-50 transition">

                <i class="fa-solid fa-arrow-left text-xs"></i>

                Volver a denuncias

            </a>

        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

            <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

                    <div>

                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                            Número de expediente
                        </p>

                        <div class="flex items-center gap-3 mt-1">

                            <span class="text-2xl font-bold text-slate-800">
                                #@Model.Id.ToString("D6")
                            </span>

                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full @statusClass border text-xs font-medium">

                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>

                                @Model.ComplaintStatus.Name

                            </span>

                        </div>

                    </div>

                    <div class="text-left sm:text-right">

                        <p class="text-xs text-slate-400">
                            Fecha de registro
                        </p>

                        <p class="text-sm font-medium text-slate-700 mt-1">
                            @Model.RegistrationDate.ToString("dd/MM/yyyy HH:mm")
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

            <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                <div class="flex items-center gap-3">

                    <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">
                        <i class="fa-solid fa-file-circle-info"></i>
                    </div>

                    <div>

                        <h3 class="text-base font-semibold text-slate-800">
                            Información general
                        </h3>

                        <p class="text-xs text-slate-500 mt-0.5">
                            Datos principales del hecho denunciado.
                        </p>

                    </div>

                </div>

            </div>

            <div class="p-6 lg:p-8">

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                    <div>

                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                            Fecha y hora del hecho
                        </p>

                        <p class="mt-1 text-sm text-slate-700">
                            @Model.DateAndTimeOfOccurrence.ToString("dd/MM/yyyy HH:mm")
                        </p>

                    </div>

                    <div>

                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                            Tipo de delito
                        </p>

                        <p class="mt-1 text-sm font-medium text-slate-700">
                            @Model.CrimeType.Name
                        </p>

                    </div>

                    <div>

                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                            Tipo de lugar
                        </p>

                        <p class="mt-1 text-sm text-slate-700">
                            @Model.LocationType.Name
                        </p>

                    </div>

                    <div>

                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                            Localidad
                        </p>

                        <p class="mt-1 text-sm text-slate-700">
                            @Model.Location.Name
                        </p>

                    </div>

                    <div>

                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                            Municipio
                        </p>

                        <p class="mt-1 text-sm text-slate-700">
                            @Model.Location.Municipality
                        </p>

                    </div>

                    <div>

                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                            Distrito
                        </p>

                        <p class="mt-1 text-sm text-slate-700">
                            @Model.Location.DistrictNumber
                        </p>

                    </div>

                    <div class="md:col-span-2 lg:col-span-3">

                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                            Dirección
                        </p>

                        <p class="mt-1 text-sm text-slate-700">
                            @(string.IsNullOrWhiteSpace(Model.Direction)
                                ? "No especificada"
                                : Model.Direction)
                        </p>

                    </div>

                </div>

                <div class="mt-6 pt-6 border-t border-slate-200">

                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                        Síntesis del hecho
                    </p>

                    <div class="mt-3 rounded-lg bg-slate-50 border border-slate-200 p-4">

                        <p class="text-sm leading-6 text-slate-700 whitespace-pre-line">
                            @Model.Synthesis
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

            <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                <div class="flex items-center gap-3">

                    <div class="w-10 h-10 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center">

                        <i class="fa-solid fa-user"></i>

                    </div>

                    <div>

                        <h3 class="text-base font-semibold text-slate-800">
                            Usuario que registró
                        </h3>

                        <p class="text-xs text-slate-500 mt-0.5">
                            Personal responsable del registro del expediente.
                        </p>

                    </div>

                </div>

            </div>

            <div class="p-6">

                <div class="flex items-center gap-4">

                    <div class="w-12 h-12 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center">

                        <i class="fa-solid fa-user-shield"></i>

                    </div>

                    <div>

                        <p class="text-sm font-semibold text-slate-800">

                            @Model.User.Name @Model.User.LastName

                        </p>

                        <p class="text-xs text-slate-400 mt-1">

                            ID de usuario: @Model.User.Id

                        </p>

                    </div>

                </div>

            </div>

        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">

                <div class="flex items-center justify-between">

                    <div>

                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                            Masculinos afectados
                        </p>

                        <p class="text-3xl font-bold text-slate-800 mt-2">
                            @Model.MasculineQuantities
                        </p>

                    </div>

                    <div class="w-11 h-11 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">

                        <i class="fa-solid fa-person"></i>

                    </div>

                </div>

            </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">

                <div class="flex items-center justify-between">

                    <div>

                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                            Femeninos afectados
                        </p>

                        <p class="text-3xl font-bold text-slate-800 mt-2">
                            @Model.FemaleQuantities
                        </p>

                    </div>

                    <div class="w-11 h-11 rounded-lg bg-pink-100 text-pink-700 flex items-center justify-center">

                        <i class="fa-solid fa-person-dress"></i>

                    </div>

                </div>

            </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">

                <div class="flex items-center justify-between">

                    <div>

                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                            Sexo desconocido
                        </p>

                        <p class="text-3xl font-bold text-slate-800 mt-2">
                            @Model.UnknownQuantities
                        </p>

                    </div>

                    <div class="w-11 h-11 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center">

                        <i class="fa-solid fa-user-question"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

            <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                <div class="flex items-center gap-3">

                    <div class="w-10 h-10 rounded-lg bg-red-100 text-red-700 flex items-center justify-center">

                        <i class="fa-solid fa-person-circle-exclamation"></i>

                    </div>

                    <div>

                        <h3 class="text-base font-semibold text-slate-800">
                            Víctimas
                        </h3>

                        <p class="text-xs text-slate-500 mt-0.5">
                            @Model.Victims.Count persona@(Model.Victims.Count == 1 ? "" : "s") registrada@(Model.Victims.Count == 1 ? "" : "s")
                        </p>

                    </div>

                </div>

            </div>

            <div class="p-6">

                @if (Model.Victims.Any())
                {
                    <div class="overflow-x-auto">

                        <table class="w-full text-sm">

                            <thead class="bg-slate-50 border-b border-slate-200">

                                <tr>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Nombre
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Apellido
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Identificación
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Sexo
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Edad
                                    </th>

                                </tr>

                            </thead>

                            <tbody class="divide-y divide-slate-100">

                                @foreach (var victim in Model.Victims)
                                {
                                    <tr class="hover:bg-slate-50">

                                        <td class="px-4 py-3 text-slate-700">
                                            @victim.Name
                                        </td>

                                        <td class="px-4 py-3 text-slate-700">
                                            @victim.LastName
                                        </td>

                                        <td class="px-4 py-3 text-slate-700">
                                            @(victim.Identification ?? "No registrada")
                                        </td>

                                        <td class="px-4 py-3 text-slate-700">
                                            @(victim.Sex ?? "No especificado")
                                        </td>

                                        <td class="px-4 py-3 text-slate-700">
                                            @(victim.Age?.ToString() ?? "No registrada")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="py-10 text-center">

                        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-3">

                            <i class="fa-solid fa-users"></i>

                        </div>

                        <p class="text-sm font-medium text-slate-600">
                            No hay víctimas registradas.
                        </p>

                    </div>
                }

            </div>

        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

            <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                <div class="flex items-center gap-3">

                    <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center">

                        <i class="fa-solid fa-eye"></i>

                    </div>

                    <div>

                        <h3 class="text-base font-semibold text-slate-800">
                            Testigos
                        </h3>

                        <p class="text-xs text-slate-500 mt-0.5">
                            @Model.Witnesses.Count testigo@(Model.Witnesses.Count == 1 ? "" : "s") registrado@(Model.Witnesses.Count == 1 ? "" : "s")
                        </p>

                    </div>

                </div>

            </div>

            <div class="p-6">

                @if (Model.Witnesses.Any())
                {
                    <div class="overflow-x-auto">

                        <table class="w-full text-sm">

                            <thead class="bg-slate-50 border-b border-slate-200">

                                <tr>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Nombre
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Apellido
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Identificación
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Sexo
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Edad
                                    </th>

                                </tr>

                            </thead>

                            <tbody class="divide-y divide-slate-100">

                                @foreach (var witness in Model.Witnesses)
                                {
                                    <tr class="hover:bg-slate-50">

                                        <td class="px-4 py-3 text-slate-700">
                                            @witness.Name
                                        </td>

                                        <td class="px-4 py-3 text-slate-700">
                                            @witness.LastName
                                        </td>

                                        <td class="px-4 py-3 text-slate-700">
                                            @(witness.Identification ?? "No registrada")
                                        </td>

                                        <td class="px-4 py-3 text-slate-700">
                                            @(witness.Sex ?? "No especificado")
                                        </td>

                                        <td class="px-4 py-3 text-slate-700">
                                            @(witness.Age?.ToString() ?? "No registrada")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="py-10 text-center">

                        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-3">

                            <i class="fa-solid fa-eye"></i>

                        </div>

                        <p class="text-sm font-medium text-slate-600">
                            No hay testigos registrados.
                        </p>

                    </div>
                }

            </div>

        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

            <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                <div class="flex items-center gap-3">

                    <div class="w-10 h-10 rounded-lg bg-slate-200 text-slate-700 flex items-center justify-center">

                        <i class="fa-solid fa-user-secret"></i>

                    </div>

                    <div>

                        <h3 class="text-base font-semibold text-slate-800">
                            Presuntos autores
                        </h3>

                        <p class="text-xs text-slate-500 mt-0.5">
                            @Model.PresumedAuthors.Count registro@(Model.PresumedAuthors.Count == 1 ? "" : "s")
                        </p>

                    </div>

                </div>

            </div>

            <div class="p-6">

                @if (Model.PresumedAuthors.Any())
                {
                    <div class="space-y-5">

                        @foreach (var author in Model.PresumedAuthors)
                        {
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">

                                <div class="flex items-center gap-3 mb-5">

                                    <div class="w-10 h-10 rounded-lg bg-white border border-slate-200 text-slate-600 flex items-center justify-center">

                                        <i class="fa-solid fa-user-secret"></i>

                                    </div>

                                    <div>

                                        <p class="text-sm font-semibold text-slate-800">

                                            @(
                                                string.Join(
                                                    " ",
                                                    new[]
                                                    {
                                                        author.Name,
                                                        author.LastName
                                                    }.Where(x => !string.IsNullOrWhiteSpace(x))
                                                )
                                            )

                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(author.Alias))
                                        {
                                            <p class="text-xs text-slate-400 mt-1">
                                                Alias: @author.Alias
                                            </p>
                                        }

                                    </div>

                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">

                                    <div>

                                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                            Sexo
                                        </p>

                                        <p class="mt-1 text-sm text-slate-700">
                                            @(author.Sex ?? "No especificado")
                                        </p>

                                    </div>

                                    <div>

                                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                            Color de piel
                                        </p>

                                        <p class="mt-1 text-sm text-slate-700">
                                            @(author.SkinColor ?? "No especificado")
                                        </p>

                                    </div>

                                    <div>

                                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                            Estatura aproximada
                                        </p>

                                        <p class="mt-1 text-sm text-slate-700">
                                            @(author.ApproximateHeight?.ToString("0.00") ?? "No registrada")
                                        </p>

                                    </div>

                                    <div>

                                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                            Cabello
                                        </p>

                                        <p class="mt-1 text-sm text-slate-700">
                                            @(author.Hair ?? "No especificado")
                                        </p>

                                    </div>

                                    <div>

                                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                            Contextura
                                        </p>

                                        <p class="mt-1 text-sm text-slate-700">
                                            @(author.Build ?? "No especificada")
                                        </p>

                                    </div>

                                    <div class="md:col-span-2 lg:col-span-3">

                                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                            Descripción
                                        </p>

                                        <p class="mt-1 text-sm text-slate-700">
                                            @(author.Description ?? "No registrada")
                                        </p>

                                    </div>

                                    <div class="md:col-span-2">

                                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                            Tatuajes
                                        </p>

                                        <p class="mt-1 text-sm text-slate-700">
                                            @(author.Tattoos ?? "No registrados")
                                        </p>

                                    </div>

                                    <div class="md:col-span-2">

                                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                                            Cicatrices
                                        </p>

                                        <p class="mt-1 text-sm text-slate-700">
                                            @(author.Scars ?? "No registradas")
                                        </p>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="py-10 text-center">

                        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-3">

                            <i class="fa-solid fa-user-secret"></i>

                        </div>

                        <p class="text-sm font-medium text-slate-600">
                            No hay presuntos autores registrados.
                        </p>

                    </div>
                }

            </div>

        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

            <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                <div class="flex items-center gap-3">

                    <div class="w-10 h-10 rounded-lg bg-red-100 text-red-700 flex items-center justify-center">

                        <i class="fa-solid fa-box-open"></i>

                    </div>

                    <div>

                        <h3 class="text-base font-semibold text-slate-800">
                            Objetos afectados
                        </h3>

                        <p class="text-xs text-slate-500 mt-0.5">
                            Bienes dañados, robados o afectados durante el hecho.
                        </p>

                    </div>

                </div>

            </div>

            <div class="p-6">

                @if (Model.AffectedObjects.Any())
                {
                    <div class="overflow-x-auto">

                        <table class="w-full text-sm">

                            <thead class="bg-slate-50 border-b border-slate-200">

                                <tr>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Objeto
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Descripción
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Cantidad
                                    </th>

                                </tr>

                            </thead>

                            <tbody class="divide-y divide-slate-100">

                                @foreach (var item in Model.AffectedObjects)
                                {
                                    <tr class="hover:bg-slate-50">

                                        <td class="px-4 py-3 font-medium text-slate-700">
                                            @item.Name
                                        </td>

                                        <td class="px-4 py-3 text-slate-700">
                                            @(item.Description ?? "Sin descripción")
                                        </td>

                                        <td class="px-4 py-3 text-slate-700">
                                            @item.Quantity
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="py-10 text-center">

                        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-3">

                            <i class="fa-solid fa-box-open"></i>

                        </div>

                        <p class="text-sm font-medium text-slate-600">
                            No hay objetos afectados registrados.
                        </p>

                    </div>
                }

            </div>

        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

            <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                <div class="flex items-center gap-3">

                    <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center">

                        <i class="fa-solid fa-screwdriver-wrench"></i>

                    </div>

                    <div>

                        <h3 class="text-base font-semibold text-slate-800">
                            Objetos utilizados
                        </h3>

                        <p class="text-xs text-slate-500 mt-0.5">
                            Armas, herramientas u otros objetos relacionados con el hecho.
                        </p>

                    </div>

                </div>

            </div>

            <div class="p-6">

                @if (Model.UsedObjects.Any())
                {
                    <div class="overflow-x-auto">

                        <table class="w-full text-sm">

                            <thead class="bg-slate-50 border-b border-slate-200">

                                <tr>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Objeto
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Descripción
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500">
                                        Cantidad
                                    </th>

                                </tr>

                            </thead>

                            <tbody class="divide-y divide-slate-100">

                                @foreach (var item in Model.UsedObjects)
                                {
                                    <tr class="hover:bg-slate-50">

                                        <td class="px-4 py-3 font-medium text-slate-700">
                                            @item.Name
                                        </td>

                                        <td class="px-4 py-3 text-slate-700">
                                            @(item.Description ?? "Sin descripción")
                                        </td>

                                        <td class="px-4 py-3 text-slate-700">
                                            @item.Quantity
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="py-10 text-center">

                        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-3">

                            <i class="fa-solid fa-screwdriver-wrench"></i>

                        </div>

                        <p class="text-sm font-medium text-slate-600">
                            No hay objetos utilizados registrados.
                        </p>

                    </div>
                }

            </div>

        </div>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">

            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

                <div>

                    <p class="text-xs text-slate-400">
                        Sistema de Gestión de Denuncias
                    </p>

                    <p class="text-sm font-medium text-slate-700 mt-1">
                        Expediente #@Model.Id.ToString("D6")
                    </p>

                </div>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="h-10 px-5 rounded-lg bg-blue-700 hover:bg-blue-800 text-white text-sm font-semibold shadow-sm transition flex items-center justify-center gap-2">

                    <i class="fa-solid fa-arrow-left text-xs"></i>

                    Volver a denuncias

                </a>

            </div>

        </div>

    </div>

</div>