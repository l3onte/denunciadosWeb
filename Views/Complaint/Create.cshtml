                        </option>

                        <option value="Desconocido">
                            Desconocido
                        </option>

                    </select>
                </td>

                <td class="px-4 py-3">
                    <input type="text"
                           name="PresumedAuthors[${presumedAuthorIndex}].Tattoos"
                           maxlength="300"
                           class="${inputClass()}"
                           placeholder="Tatuajes">
                </td>

                <td class="px-4 py-3">
                    <input type="text"
                           name="PresumedAuthors[${presumedAuthorIndex}].Scars"
                           maxlength="300"
                           class="${inputClass()}"
                           placeholder="Cicatrices">
                </td>

                <td class="px-4 py-3 text-center">

                    <button type="button"
                            onclick="removeRow(this)"
                            class="w-8 h-8 rounded-md text-red-500 hover:bg-red-50 transition">

                        <i class="fa-solid fa-trash text-xs"></i>

                    </button>

                </td>
            `;

            tbody.appendChild(row);

            presumedAuthorIndex++;

            updateEmptyStates();
        }

        function addAffectedObject()
        {
            const tbody = document.getElementById("affectedObjectsBody");

            const row = document.createElement("tr");

            row.innerHTML = `
                <td class="px-4 py-3">
                    <input type="text"
                           name="AffectedObjects[${affectedObjectIndex}].Name"
                           maxlength="100"
                           class="${inputClass()}"
                           placeholder="Ej. Teléfono celular">
                </td>

                <td class="px-4 py-3">
                    <input type="text"
                           name="AffectedObjects[${affectedObjectIndex}].Description"
                           maxlength="300"
                           class="${inputClass()}"
                           placeholder="Ej. Pantalla rota">
                </td>

                <td class="px-4 py-3">
                    <input type="number"
                           name="AffectedObjects[${affectedObjectIndex}].Quantity"
                           min="1"
                           value="1"
                           class="${inputClass()}">
                </td>

                <td class="px-4 py-3 text-center">

                    <button type="button"
                            onclick="removeRow(this)"
                            class="w-8 h-8 rounded-md text-red-500 hover:bg-red-50 transition">

                        <i class="fa-solid fa-trash text-xs"></i>

                    </button>

                </td>
            `;

            tbody.appendChild(row);

            affectedObjectIndex++;

            updateEmptyStates();
        }

        function addUsedObject()
        {
            const tbody = document.getElementById("usedObjectsBody");

            const row = document.createElement("tr");

            row.innerHTML = `
                <td class="px-4 py-3">
                    <input type="text"
                           name="UsedObjects[${usedObjectIndex}].Name"
                           maxlength="100"
                           class="${inputClass()}"
                           placeholder="Ej. Pistola">
                </td>

                <td class="px-4 py-3">
                    <input type="text"
                           name="UsedObjects[${usedObjectIndex}].Description"
                           maxlength="300"
                           class="${inputClass()}"
                           placeholder="Ej. Arma de fuego">
                </td>

                <td class="px-4 py-3">
                    <input type="number"
                           name="UsedObjects[${usedObjectIndex}].Quantity"
                           min="1"
                           value="1"
                           class="${inputClass()}">
                </td>

                <td class="px-4 py-3 text-center">

                    <button type="button"
                            onclick="removeRow(this)"
                            class="w-8 h-8 rounded-md text-red-500 hover:bg-red-50 transition">

                        <i class="fa-solid fa-trash text-xs"></i>

                    </button>

                </td>
            `;

            tbody.appendChild(row);

            usedObjectIndex++;

            updateEmptyStates();
        }

        function reindexRows(tbodyId, prefix)
        {
            const rows = document.querySelectorAll(`#${tbodyId} tr`);

            rows.forEach((row, index) =>
            {
                const inputs = row.querySelectorAll("input, select, textarea");

                inputs.forEach(input =>
                {
                    const name = input.getAttribute("name");

                    if (!name)
                    {
                        return;
                    }

                    const property = name.substring(
                        name.indexOf("].") + 2
                    );

                    input.setAttribute(
                        "name",
                        `${prefix}[${index}].${property}`
                    );
                });
            });
        }

        function reindexAllRows()
        {
            reindexRows(
                "victimsBody",
                "Victims"
            );

            reindexRows(
                "witnessesBody",
                "Witnesses"
            );

            reindexRows(
                "presumedAuthorsBody",
                "PresumedAuthors"
            );

            reindexRows(
                "affectedObjectsBody",
                "AffectedObjects"
            );

            reindexRows(
                "usedObjectsBody",
                "UsedObjects"
            );
        }

        document.getElementById("complaintForm")
            .addEventListener("submit", function ()
            {
                reindexAllRows();
            });

        updateEmptyStates();

    </script>
}