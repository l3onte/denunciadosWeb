@model denunciadosWeb.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Acceso al Sistema";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sistema de Denuncias</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>

<body>

    <div class="min-h-screen bg-slate-100 flex items-center justify-center p-6">

        <div class="w-full max-w-5xl bg-white rounded-lg shadow-xl overflow-hidden border border-slate-200">

            <div class="grid grid-cols-1 md:grid-cols-2 min-h-[560px]">

                <div class="bg-slate-900 text-white flex flex-col justify-between p-10 md:p-12">

                    <div>

                        <div class="flex items-center gap-4 mb-12">

                            <div class="w-16 h-16 rounded-full border border-slate-500 flex items-center justify-center bg-slate-800">
                                <i class="fa-solid fa-shield-halved text-2xl text-slate-200"></i>
                            </div>

                            <div>
                                <p class="text-xs uppercase tracking-[0.2em] text-slate-400">
                                    Sistema Institucional
                                </p>

                                <h1 class="text-xl font-semibold tracking-wide">
                                    Registro de Denuncias
                                </h1>
                            </div>

                        </div>

                        <div class="max-w-md">

                            <p class="text-sm uppercase tracking-[0.18em] text-slate-400 mb-3">
                                Plataforma de gestión
                            </p>

                            <h2 class="text-3xl md:text-4xl font-semibold leading-tight mb-6">
                                Sistema de Registro de Denuncias
                            </h2>

                            <div class="w-16 h-1 bg-blue-700 mb-6"></div>

                            <p class="text-slate-300 leading-7 text-sm">
                                Plataforma destinada al registro, consulta y gestión
                                de información relacionada con denuncias e incidencias.
                            </p>

                        </div>

                    </div>

                    <div class="border-t border-slate-700 pt-6 mt-10">

                        <div class="flex items-start gap-3">

                            <i class="fa-solid fa-circle-info text-slate-400 mt-1"></i>

                            <p class="text-xs leading-5 text-slate-400">
                                El acceso a este sistema está restringido al personal
                                autorizado. Toda información registrada debe ser
                                manejada de acuerdo con las normas y procedimientos
                                establecidos.
                            </p>

                        </div>

                    </div>

                </div>

                <div class="flex items-center justify-center p-8 md:p-12">

                    <div class="w-full max-w-md">

                        <div class="mb-8">

                            <p class="text-xs uppercase tracking-[0.18em] text-slate-500 mb-2">
                                Acceso seguro
                            </p>

                            <h2 class="text-2xl font-semibold text-slate-900">
                                Iniciar sesión
                            </h2>

                            <p class="text-sm text-slate-500 mt-2">
                                Ingrese sus credenciales para acceder al sistema.
                            </p>

                        </div>

                        <form asp-controller="Account"
                              asp-action="LoginValidation"
                              method="post">

                            <div class="mb-5">

                                <label asp-for="Name"
                                       class="block text-sm font-medium text-slate-700 mb-2">
                                    Usuario
                                </label>

                                <div class="relative">

                                    <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
                                        <i class="fa-solid fa-user text-slate-400"></i>
                                    </div>

                                    <input asp-for="Name"
                                           type="text"
                                           autocomplete="username"
                                           placeholder="Ingrese su usuario"
                                           class="w-full h-12 pl-11 pr-4 rounded-md border border-slate-300 bg-white text-slate-900 text-sm outline-none transition focus:border-blue-700 focus:ring-2 focus:ring-blue-700/10" />

                                </div>

                                <span asp-validation-for="Name"
                                      class="text-xs text-red-600 mt-1">
                                </span>

                            </div>

                            <div class="mb-6">

                                <label asp-for="Password"
                                       class="block text-sm font-medium text-slate-700 mb-2">
                                    Contraseña
                                </label>

                                <div class="relative">

                                    <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
                                        <i class="fa-solid fa-lock text-slate-400"></i>
                                    </div>

                                    <input asp-for="Password"
                                           type="password"
                                           autocomplete="current-password"
                                           placeholder="Ingrese su contraseña"
                                           class="w-full h-12 pl-11 pr-4 rounded-md border border-slate-300 bg-white text-slate-900 text-sm outline-none transition focus:border-blue-700 focus:ring-2 focus:ring-blue-700/10" />

                                </div>

                                <span asp-validation-for="Password"
                                      class="text-xs text-red-600 mt-1">
                                </span>

                            </div>

                            <div asp-validation-summary="ModelOnly"
                                 class="mb-5 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                            </div>

                            <button type="submit"
                                    class="w-full h-12 rounded-md bg-blue-800 hover:bg-blue-900 text-white font-medium text-sm transition duration-200 flex items-center justify-center gap-3">

                                <i class="fa-solid fa-right-to-bracket"></i>

                                Iniciar sesión

                            </button>

                        </form>

                        <div class="mt-8 pt-6 border-t border-slate-200">

                            <p class="text-center text-xs text-slate-400">
                                Sistema de uso institucional
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>