@model denunciadosWeb.Models.CreateComplaintViewModel

@{
    ViewData["Title"] = "Nueva Denuncia";

    var crimeTypes =
        ViewBag.CrimeTypes as IEnumerable<denunciadosWeb.Models.TypeOfCrime>
        ?? Enumerable.Empty<denunciadosWeb.Models.TypeOfCrime>();

    var locationTypes =
        ViewBag.LocationTypes as IEnumerable<denunciadosWeb.Models.LocationType>
        ?? Enumerable.Empty<denunciadosWeb.Models.LocationType>();

    var complaintStatuses =
        ViewBag.ComplaintStatuses as IEnumerable<denunciadosWeb.Models.ComplaintStatus>
        ?? Enumerable.Empty<denunciadosWeb.Models.ComplaintStatus>();

    var locations =
        ViewBag.Locations as IEnumerable<denunciadosWeb.Models.Location>
        ?? Enumerable.Empty<denunciadosWeb.Models.Location>();
}

<div class="min-h-[calc(100vh-4rem)] bg-slate-100 px-4 py-6 sm:px-6 lg:px-8">

    <div class="max-w-7xl mx-auto">

        <!-- ENCABEZADO -->

        <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

            <div>

                <h2 class="text-2xl font-semibold text-slate-800">
                    Registrar nueva denuncia
                </h2>

                <p class="mt-1 text-sm text-slate-500">
                    Registre la información del hecho y los elementos relacionados con la denuncia.
                </p>

            </div>

            <a asp-controller="Home"
               asp-action="Index"
               class="inline-flex items-center justify-center gap-2 h-10 px-4 rounded-lg border border-slate-300 bg-white text-slate-600 text-sm font-medium hover:bg-slate-50 transition">

                <i class="fa-solid fa-arrow-left text-xs"></i>

                Volver a denuncias

            </a>

        </div>

        <form asp-controller="Complaint"
              asp-action="Create"
              method="post"
              id="complaintForm">

            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">

                    <div class="flex items-start gap-3">

                        <i class="fa-solid fa-circle-exclamation mt-0.5"></i>

                        <div>
                            <p class="font-semibold">
                                No se pudo registrar la denuncia.
                            </p>

                            <div asp-validation-summary="ModelOnly"
                                 class="mt-1">
                            </div>
                        </div>

                    </div>

                </div>
            }

            <!-- INFORMACIÓN DEL HECHO -->

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

                <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                    <div class="flex items-center gap-3">

                        <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">
                            <i class="fa-solid fa-file-circle-plus"></i>
                        </div>

                        <div>

                            <h3 class="text-base font-semibold text-slate-800">
                                Información del hecho
                            </h3>

                            <p class="text-xs text-slate-500 mt-0.5">
                                Datos principales de la denuncia.
                            </p>

                        </div>

                    </div>

                </div>

                <div class="p-6 lg:p-8">

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                        <!-- FECHA Y HORA -->

                        <div>

                            <label asp-for="DateAndTimeOfOccurrence"
                                   class="block text-xs font-semibold text-slate-600 mb-1.5">
                                Fecha y hora del hecho
                            </label>

                            <input asp-for="DateAndTimeOfOccurrence"
                                   type="datetime-local"
                                   class="w-full h-10 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

                            <span asp-validation-for="DateAndTimeOfOccurrence"
                                  class="block mt-1 text-xs text-red-600">
                            </span>

                        </div>

                        <!-- TIPO DE DELITO -->

                        <div>

                            <label asp-for="CrimeTypeId"
                                   class="block text-xs font-semibold text-slate-600 mb-1.5">
                                Tipo de delito
                            </label>

                            <select asp-for="CrimeTypeId"
                                    class="w-full h-10 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-600 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                                <option value="">
                                    Seleccione un delito
                                </option>

                                @foreach (var crimeType in crimeTypes)
                                {
                                    <option value="@crimeType.Id">
                                        @crimeType.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CrimeTypeId"
                                  class="block mt-1 text-xs text-red-600">
                            </span>

                        </div>

                        <!-- TIPO DE LUGAR -->

                        <div>

                            <label asp-for="LocationTypeId"
                                   class="block text-xs font-semibold text-slate-600 mb-1.5">
                                Tipo de lugar
                            </label>

                            <select asp-for="LocationTypeId"
                                    class="w-full h-10 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-600 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                                <option value="">
                                    Seleccione el tipo de lugar
                                </option>

                                @foreach (var locationType in locationTypes)
                                {
                                    <option value="@locationType.Id">
                                        @locationType.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="LocationTypeId"
                                  class="block mt-1 text-xs text-red-600">
                            </span>

                        </div>

                        <!-- LOCALIDAD -->

                        <div>

                            <label asp-for="LocationId"
                                   class="block text-xs font-semibold text-slate-600 mb-1.5">
                                Localidad / Barrio
                            </label>

                            <select asp-for="LocationId"
                                    class="w-full h-10 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-600 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                                <option value="">
                                    Seleccione una localidad
                                </option>

                                @foreach (var location in locations)
                                {
                                    <option value="@location.Id">
                                        @location.Name - @location.Municipality
                                        (Distrito @location.DistrictNumber)
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="LocationId"
                                  class="block mt-1 text-xs text-red-600">
                            </span>

                        </div>

                        <!-- DIRECCIÓN -->

                        <div>

                            <label asp-for="Direction"
                                   class="block text-xs font-semibold text-slate-600 mb-1.5">
                                Dirección
                            </label>

                            <input asp-for="Direction"
                                   type="text"
                                   maxlength="200"
                                   placeholder="Ej. Frente al parque central"
                                   class="w-full h-10 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-700 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />

                            <span asp-validation-for="Direction"
                                  class="block mt-1 text-xs text-red-600">
                            </span>

                        </div>

                        <!-- ESTADO -->

                        <div>

                            <label asp-for="ComplaintStatusId"
                                   class="block text-xs font-semibold text-slate-600 mb-1.5">
                                Estado de la denuncia
                            </label>

                            <select asp-for="ComplaintStatusId"
                                    class="w-full h-10 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-600 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                                <option value="">
                                    Seleccione un estado
                                </option>

                                @foreach (var status in complaintStatuses)
                                {
                                    <option value="@status.Id">
                                        @status.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ComplaintStatusId"
                                  class="block mt-1 text-xs text-red-600">
                            </span>

                        </div>

                    </div>

                    <!-- SÍNTESIS -->

                    <div class="mt-6">

                        <label asp-for="Synthesis"
                               class="block text-xs font-semibold text-slate-600 mb-1.5">
                            Síntesis del hecho
                        </label>

                        <textarea asp-for="Synthesis"
                                  rows="5"
                                  maxlength="500"
                                  placeholder="Describa brevemente lo ocurrido..."
                                  class="w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-700 placeholder-slate-400 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100 resize-none"></textarea>

                        <div class="flex items-center justify-between mt-1">

                            <span asp-validation-for="Synthesis"
                                  class="text-xs text-red-600">
                            </span>

                            <span class="text-xs text-slate-400">
                                Máximo 500 caracteres
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- VÍCTIMAS -->

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

                <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

                        <div class="flex items-center gap-3">

                            <div class="w-10 h-10 rounded-lg bg-red-100 text-red-700 flex items-center justify-center">
                                <i class="fa-solid fa-person-circle-exclamation"></i>
                            </div>

                            <div>

                                <h3 class="text-base font-semibold text-slate-800">
                                    Víctimas
                                </h3>

                                <p class="text-xs text-slate-500 mt-0.5">
                                    Personas afectadas directamente por el hecho.
                                </p>

                            </div>

                        </div>

                        <button type="button"
                                onclick="addVictim()"
                                class="h-9 px-4 rounded-lg bg-blue-700 hover:bg-blue-800 text-white text-xs font-semibold transition flex items-center justify-center gap-2">

                            <i class="fa-solid fa-plus"></i>

                            Agregar víctima

                        </button>

                    </div>

                </div>

                <div class="p-6">

                    <div class="overflow-x-auto">

                        <table class="w-full text-sm min-w-[850px]">

                            <thead class="bg-slate-50 border-b border-slate-200">

                                <tr>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Nombre
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Apellido
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Identificación
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Sexo
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Edad
                                    </th>

                                    <th class="px-4 py-3 w-14"></th>

                                </tr>

                            </thead>

                            <tbody id="victimsBody"
                                   class="divide-y divide-slate-100">
                            </tbody>

                        </table>

                    </div>

                    <div id="emptyVictims"
                         class="py-10 text-center">

                        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-3">

                            <i class="fa-solid fa-users"></i>

                        </div>

                        <p class="text-sm font-medium text-slate-600">
                            No hay víctimas registradas
                        </p>

                        <p class="text-xs text-slate-400 mt-1">
                            Agregue las personas afectadas por el hecho.
                        </p>

                    </div>

                </div>

            </div>


            <!-- TESTIGOS -->

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

                <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

                        <div class="flex items-center gap-3">

                            <div class="w-10 h-10 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center">
                                <i class="fa-solid fa-eye"></i>
                            </div>

                            <div>

                                <h3 class="text-base font-semibold text-slate-800">
                                    Testigos
                                </h3>

                                <p class="text-xs text-slate-500 mt-0.5">
                                    Personas que presenciaron o conocen información del hecho.
                                </p>

                            </div>

                        </div>

                        <button type="button"
                                onclick="addWitness()"
                                class="h-9 px-4 rounded-lg bg-blue-700 hover:bg-blue-800 text-white text-xs font-semibold transition flex items-center justify-center gap-2">

                            <i class="fa-solid fa-plus"></i>

                            Agregar testigo

                        </button>

                    </div>

                </div>

                <div class="p-6">

                    <div class="overflow-x-auto">

                        <table class="w-full text-sm min-w-[850px]">

                            <thead class="bg-slate-50 border-b border-slate-200">

                                <tr>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Nombre
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Apellido
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Identificación
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Sexo
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Edad
                                    </th>

                                    <th class="px-4 py-3 w-14"></th>

                                </tr>

                            </thead>

                            <tbody id="witnessesBody"
                                   class="divide-y divide-slate-100">
                            </tbody>

                        </table>

                    </div>

                    <div id="emptyWitnesses"
                         class="py-10 text-center">

                        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-3">

                            <i class="fa-solid fa-eye"></i>

                        </div>

                        <p class="text-sm font-medium text-slate-600">
                            No hay testigos registrados
                        </p>

                        <p class="text-xs text-slate-400 mt-1">
                            Agregue las personas relacionadas con el hecho.
                        </p>

                    </div>

                </div>

            </div>


            <!-- PRESUNTOS AUTORES -->

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

                <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

                        <div class="flex items-center gap-3">

                            <div class="w-10 h-10 rounded-lg bg-slate-200 text-slate-700 flex items-center justify-center">
                                <i class="fa-solid fa-user-secret"></i>
                            </div>

                            <div>

                                <h3 class="text-base font-semibold text-slate-800">
                                    Presuntos autores
                                </h3>

                                <p class="text-xs text-slate-500 mt-0.5">
                                    Información conocida sobre los posibles responsables.
                                </p>

                            </div>

                        </div>

                        <button type="button"
                                onclick="addPresumedAuthor()"
                                class="h-9 px-4 rounded-lg bg-blue-700 hover:bg-blue-800 text-white text-xs font-semibold transition flex items-center justify-center gap-2">

                            <i class="fa-solid fa-plus"></i>

                            Agregar presunto autor

                        </button>

                    </div>

                </div>

                <div class="p-6">

                    <div class="overflow-x-auto">

                        <table class="w-full text-sm min-w-[1900px]">

                            <thead class="bg-slate-50 border-b border-slate-200">

                                <tr>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Nombre
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Apellido
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Alias
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Descripción
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Color de piel
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Estatura
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Cabello
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Contextura
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Sexo
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Tatuajes
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Cicatrices
                                    </th>

                                    <th class="px-4 py-3 w-14"></th>

                                </tr>

                            </thead>

                            <tbody id="presumedAuthorsBody"
                                   class="divide-y divide-slate-100">
                            </tbody>

                        </table>

                    </div>

                    <div id="emptyPresumedAuthors"
                         class="py-10 text-center">

                        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-3">

                            <i class="fa-solid fa-user-secret"></i>

                        </div>

                        <p class="text-sm font-medium text-slate-600">
                            No hay presuntos autores registrados
                        </p>

                        <p class="text-xs text-slate-400 mt-1">
                            Agregue un presunto autor cuando exista información disponible.
                        </p>

                    </div>

                </div>

            </div>


            <!-- OBJETOS AFECTADOS -->

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

                <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

                        <div class="flex items-center gap-3">

                            <div class="w-10 h-10 rounded-lg bg-red-100 text-red-700 flex items-center justify-center">
                                <i class="fa-solid fa-box-open"></i>
                            </div>

                            <div>

                                <h3 class="text-base font-semibold text-slate-800">
                                    Objetos afectados
                                </h3>

                                <p class="text-xs text-slate-500 mt-0.5">
                                    Objetos dañados, robados o afectados durante el hecho.
                                </p>

                            </div>

                        </div>

                        <button type="button"
                                onclick="addAffectedObject()"
                                class="h-9 px-4 rounded-lg bg-blue-700 hover:bg-blue-800 text-white text-xs font-semibold transition flex items-center justify-center gap-2">

                            <i class="fa-solid fa-plus"></i>

                            Agregar objeto

                        </button>

                    </div>

                </div>

                <div class="p-6">

                    <div class="overflow-x-auto">

                        <table class="w-full text-sm min-w-[700px]">

                            <thead class="bg-slate-50 border-b border-slate-200">

                                <tr>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Objeto
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Descripción
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Cantidad
                                    </th>

                                    <th class="px-4 py-3 w-14"></th>

                                </tr>

                            </thead>

                            <tbody id="affectedObjectsBody"
                                   class="divide-y divide-slate-100">
                            </tbody>

                        </table>

                    </div>

                    <div id="emptyAffectedObjects"
                         class="py-10 text-center">

                        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-3">

                            <i class="fa-solid fa-box-open"></i>

                        </div>

                        <p class="text-sm font-medium text-slate-600">
                            No hay objetos afectados registrados
                        </p>

                        <p class="text-xs text-slate-400 mt-1">
                            Agregue los bienes dañados, robados o afectados.
                        </p>

                    </div>

                </div>

            </div>


            <!-- OBJETOS UTILIZADOS -->

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">

                <div class="px-6 py-5 border-b border-slate-200 bg-slate-50">

                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

                        <div class="flex items-center gap-3">

                            <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center">
                                <i class="fa-solid fa-screwdriver-wrench"></i>
                            </div>

                            <div>

                                <h3 class="text-base font-semibold text-slate-800">
                                    Objetos utilizados
                                </h3>

                                <p class="text-xs text-slate-500 mt-0.5">
                                    Armas, herramientas u otros objetos utilizados durante el hecho.
                                </p>

                            </div>

                        </div>

                        <button type="button"
                                onclick="addUsedObject()"
                                class="h-9 px-4 rounded-lg bg-blue-700 hover:bg-blue-800 text-white text-xs font-semibold transition flex items-center justify-center gap-2">

                            <i class="fa-solid fa-plus"></i>

                            Agregar objeto

                        </button>

                    </div>

                </div>

                <div class="p-6">

                    <div class="overflow-x-auto">

                        <table class="w-full text-sm min-w-[700px]">

                            <thead class="bg-slate-50 border-b border-slate-200">

                                <tr>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Objeto
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Descripción
                                    </th>

                                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                                        Cantidad
                                    </th>

                                    <th class="px-4 py-3 w-14"></th>

                                </tr>

                            </thead>

                            <tbody id="usedObjectsBody"
                                   class="divide-y divide-slate-100">
                            </tbody>

                        </table>

                    </div>

                    <div id="emptyUsedObjects"
                         class="py-10 text-center">

                        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mb-3">

                            <i class="fa-solid fa-screwdriver-wrench"></i>

                        </div>

                        <p class="text-sm font-medium text-slate-600">
                            No hay objetos utilizados registrados
                        </p>

                        <p class="text-xs text-slate-400 mt-1">
                            Registre armas, herramientas u otros elementos utilizados.
                        </p>

                    </div>

                </div>

            </div>


            <!-- BOTONES -->

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 mb-6">

                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">

                    <div>

                        <p class="text-sm font-semibold text-slate-700">
                            ¿Desea registrar esta denuncia?
                        </p>

                        <p class="text-xs text-slate-400 mt-1">
                            Verifique la información antes de guardar el expediente.
                        </p>

                    </div>

                    <div class="flex flex-col sm:flex-row gap-3">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="h-10 px-5 rounded-lg border border-slate-300 bg-white text-slate-600 text-sm font-medium hover:bg-slate-50 transition flex items-center justify-center gap-2">

                            <i class="fa-solid fa-xmark text-xs"></i>

                            Cancelar

                        </a>

                        <button type="submit"
                                class="h-10 px-6 rounded-lg bg-blue-700 hover:bg-blue-800 text-white text-sm font-semibold shadow-sm transition flex items-center justify-center gap-2">

                            <i class="fa-solid fa-floppy-disk text-xs"></i>

                            Registrar denuncia

                        </button>

                    </div>

                </div>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        let victimIndex = 0;
        let witnessIndex = 0;
        let presumedAuthorIndex = 0;
        let affectedObjectIndex = 0;
        let usedObjectIndex = 0;

        function inputClass()
        {
            return "w-full h-9 rounded-md border border-slate-300 bg-white px-2.5 text-xs text-slate-700 placeholder-slate-400 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100";
        }

        function removeRow(button)
        {
            button.closest("tr").remove();

            updateEmptyStates();
        }

        function updateEmptyStates()
        {
            document.getElementById("emptyVictims").classList.toggle(
                "hidden",
                document.querySelectorAll("#victimsBody tr").length > 0
            );

            document.getElementById("emptyWitnesses").classList.toggle(
                "hidden",
                document.querySelectorAll("#witnessesBody tr").length > 0
            );

            document.getElementById("emptyPresumedAuthors").classList.toggle(
                "hidden",
                document.querySelectorAll("#presumedAuthorsBody tr").length > 0
            );

            document.getElementById("emptyAffectedObjects").classList.toggle(
                "hidden",
                document.querySelectorAll("#affectedObjectsBody tr").length > 0
            );

            document.getElementById("emptyUsedObjects").classList.toggle(
                "hidden",
                document.querySelectorAll("#usedObjectsBody tr").length > 0
            );
        }

        function addVictim()
        {
            const tbody = document.getElementById("victimsBody");

            const row = document.createElement("tr");

            row.innerHTML = `
                <td class="px-4 py-3">
                    <input type="text"
                           name="Victims[${victimIndex}].Name"
                           maxlength="100"
                           class="${inputClass()}"
                           placeholder="Nombre">
                </td>

                <td class="px-4 py-3">
                    <input type="text"
                           name="Victims[${victimIndex}].LastName"
                           maxlength="100"
                           class="${inputClass()}"
                           placeholder="Apellido">
                </td>

                <td class="px-4 py-3">
                    <input type="text"
                           name="Victims[${victimIndex}].Identification"
                           maxlength="40"
                           class="${inputClass()}"
                           placeholder="Identificación">
                </td>

                <td class="px-4 py-3">
                    <select name="Victims[${victimIndex}].Sex"
                            class="${inputClass()}">

                        <option value="">
                            Seleccionar
                        </option>

                        <option value="Masculino">
                            Masculino
                        </option>

                        <option value="Femenino">
                            Femenino
                        </option>

                        <option value="Desconocido">
                            Desconocido
                        </option>

                    </select>
                </td>

                <td class="px-4 py-3">
                    <input type="number"
                           name="Victims[${victimIndex}].Age"
                           min="0"
                           max="120"
                           class="${inputClass()}"
                           placeholder="Edad">
                </td>

                <td class="px-4 py-3 text-center">

                    <button type="button"
                            onclick="removeRow(this)"
                            class="w-8 h-8 rounded-md text-red-500 hover:bg-red-50 transition">

                        <i class="fa-solid fa-trash text-xs"></i>

                    </button>

                </td>
            `;

            tbody.appendChild(row);

            victimIndex++;

            updateEmptyStates();
        }

        function addWitness()
        {
            const tbody = document.getElementById("witnessesBody");

            const row = document.createElement("tr");

            row.innerHTML = `
                <td class="px-4 py-3">
                    <input type="text"
                           name="Witnesses[${witnessIndex}].Name"
                           maxlength="100"
                           class="${inputClass()}"
                           placeholder="Nombre">
                </td>

                <td class="px-4 py-3">
                    <input type="text"
                           name="Witnesses[${witnessIndex}].LastName"
                           maxlength="100"
                           class="${inputClass()}"
                           placeholder="Apellido">
                </td>

                <td class="px-4 py-3">
                    <input type="text"
                           name="Witnesses[${witnessIndex}].Identification"
                           maxlength="40"
                           class="${inputClass()}"
                           placeholder="Identificación">
                </td>

                <td class="px-4 py-3">
                    <select name="Witnesses[${witnessIndex}].Sex"
                            class="${inputClass()}">

                        <option value="">
                            Seleccionar
                        </option>

                        <option value="Masculino">
                            Masculino
                        </option>

                        <option value="Femenino">
                            Femenino
                        </option>

                        <option value="Desconocido">
                            Desconocido
                        </option>

                    </select>
                </td>

                <td class="px-4 py-3">
                    <input type="number"
                           name="Witnesses[${witnessIndex}].Age"
                           min="0"
                           max="120"
                           class="${inputClass()}"
                           placeholder="Edad">
                </td>

                <td class="px-4 py-3 text-center">

                    <button type="button"
                            onclick="removeRow(this)"
                            class="w-8 h-8 rounded-md text-red-500 hover:bg-red-50 transition">

                        <i class="fa-solid fa-trash text-xs"></i>

                    </button>

                </td>
            `;

            tbody.appendChild(row);

            witnessIndex++;

            updateEmptyStates();
        }

        function addPresumedAuthor()
        {
            const tbody = document.getElementById("presumedAuthorsBody");

            const row = document.createElement("tr");

            row.innerHTML = `
                <td class="px-4 py-3">
                    <input type="text"
                           name="PresumedAuthors[${presumedAuthorIndex}].Name"
                           maxlength="100"
                           class="${inputClass()}"
                           placeholder="Nombre">
                </td>

                <td class="px-4 py-3">
                    <input type="text"
                           name="PresumedAuthors[${presumedAuthorIndex}].LastName"
                           maxlength="100"
                           class="${inputClass()}"
                           placeholder="Apellido">
                </td>

                <td class="px-4 py-3">
                    <input type="text"
                           name="PresumedAuthors[${presumedAuthorIndex}].Alias"
                           maxlength="100"
                           class="${inputClass()}"
                           placeholder="Alias">
                </td>

                <td class="px-4 py-3">
                    <input type="text"
                           name="PresumedAuthors[${presumedAuthorIndex}].Description"
                           maxlength="300"
                           class="${inputClass()}"
                           placeholder="Descripción">
                </td>

                <td class="px-4 py-3">
                    <input type="text"
                           name="PresumedAuthors[${presumedAuthorIndex}].SkinColor"
                           maxlength="30"
                           class="${inputClass()}"
                           placeholder="Color de piel">
                </td>

                <td class="px-4 py-3">
                    <input type="number"
                           name="PresumedAuthors[${presumedAuthorIndex}].ApproximateHeight"
                           min="0"
                           max="9.99"
                           step="0.01"
